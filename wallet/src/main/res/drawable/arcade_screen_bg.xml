<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#020403" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#1400E5FF"
                android:centerColor="#05000000"
                android:endColor="#16FF2D95" />
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#2418FF74" />
        </shape>
    </item>
</layer-list>
